{
  "schemaVersion": "1.0",
  "entities": {
    "products": {
      "firestorePath": "products/{productId}",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "price": { "type": "number", "required": true },
        "newPrice": { "type": "number", "required": false },
        "consumerPrice": { "type": "number", "required": false },
        "buyPrice": { "type": "number", "required": false },
        "stock": { "type": "number", "required": false },
        "category": { "type": "string", "required": false },
        "image": { "type": "string", "required": false },
        "badge": { "type": "string", "required": false },
        "unit": { "type": "string", "required": false },
        "updatedAt": { "type": "string", "required": false }
      }
    },
    "orders": {
      "firestorePath": "orders/{orderId}",
      "fields": {
        "id": { "type": "string", "required": true },
        "orderNumber": { "type": "string", "required": true },
        "totalAmount": { "type": "number", "required": true },
        "status": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    },
    "customers": {
      "firestorePath": "customers/{customerId}",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "phone": { "type": "string", "required": true },
        "address": { "type": "string", "required": false },
        "walletBalance": { "type": "number", "required": false },
        "giftCredit": { "type": "number", "required": false },
        "walletHistory": { "type": "array", "required": false },
        "passwordHash": { "type": "string", "required": false },
        "totalOrders": { "type": "number", "required": false },
        "totalSpent": { "type": "number", "required": false },
        "lastOrderAt": { "type": "string", "required": false },
        "createdAt": { "type": "string", "required": false },
        "updatedAt": { "type": "string", "required": false }
      }
    },
    "transactions": {
      "firestorePath": "transactions/{transactionId}",
      "fields": {
        "id": { "type": "string", "required": true },
        "type": { "type": "string", "required": true },
        "amount": { "type": "number", "required": true }
      }
    },
    "company_payments": {
      "firestorePath": "company_payments/{paymentId}",
      "fields": {
        "id": { "type": "string", "required": true },
        "paymentDate": { "type": "string", "required": true },
        "fromDate": { "type": "string", "required": true },
        "toDate": { "type": "string", "required": true },
        "totalBuyCost": { "type": "number", "required": true },
        "totalItemsCount": { "type": "number", "required": true },
        "ordersCount": { "type": "number", "required": true },
        "refNumber": { "type": "string", "required": false },
        "notes": { "type": "string", "required": false },
        "status": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    }
  }
}
